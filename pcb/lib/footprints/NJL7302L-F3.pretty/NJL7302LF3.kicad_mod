(module "NJL7302LF3" (layer F.Cu)
  (descr "4mm x 4mm")
  (tags "Phototransistor")
  (fp_text reference Q** (at -1.270 -0) (layer F.SilkS)
    (effects (font (size 1.27 1.27) (thickness 0.254)))
  )
  (fp_text user %R (at -1.270 -0) (layer F.Fab)
    (effects (font (size 1.27 1.27) (thickness 0.254)))
  )
  (fp_text value "NJL7302LF3" (at -1.270 -0) (layer F.SilkS) hide
    (effects (font (size 1.27 1.27) (thickness 0.254)))
  )
  (fp_line (start -4.27 -3) (end 1.73 -3) (layer F.CrtYd) (width 0.1))
  (fp_line (start 1.73 -3) (end 1.73 3) (layer F.CrtYd) (width 0.1))
  (fp_line (start 1.73 3) (end -4.27 3) (layer F.CrtYd) (width 0.1))
  (fp_line (start -4.27 3) (end -4.27 -3) (layer F.CrtYd) (width 0.1))
  (fp_line (start -1.27 -2) (end -1.27 -2) (layer F.Fab) (width 0.1))
  (fp_line (start -1.27 2) (end -1.27 2) (layer F.Fab) (width 0.1))
  (fp_line (start 1.2 -0) (end 1.2 -0) (layer F.SilkS) (width 0.1))
  (fp_line (start 1.3 -0) (end 1.3 -0) (layer F.SilkS) (width 0.1))
  (fp_arc (start -1.27 -0) (end -1.270 -2) (angle -180) (layer F.Fab) (width 0.1))
  (fp_arc (start -1.27 -0) (end -1.270 2) (angle -180) (layer F.Fab) (width 0.1))
  (fp_arc (start 1.25 -0) (end 1.200 -0) (angle -180) (layer F.SilkS) (width 0.1))
  (fp_arc (start 1.25 -0) (end 1.300 -0) (angle -180) (layer F.SilkS) (width 0.1))
  (pad 1 thru_hole rect (at 0.000 -0) (size 1.300 1.300) (drill 0.8) (layers *.Cu *.Mask))
  (pad 2 thru_hole circle (at -2.540 -0) (size 1.300 1.300) (drill 0.8) (layers *.Cu *.Mask))
  (model "${KIPRJMOD}/lib/3dmodels/NJL7302L-F3.stp"
    (at (xyz 0 0 0))
    (scale (xyz 1 1 1))
    (rotate (xyz 0 0 0))
  )
)
